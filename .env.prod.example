# Bider production environment (on the VPS). Copy to .env and fill in real values.
#   cp .env.prod.example .env && chmod 600 .env
# Never commit .env. WB tokens are NOT stored here — they are added later
# through the web UI (/admin/cabinets) and stored encrypted in Postgres.

# --- Postgres (used by both the postgres service and the app URL built in compose) ---
POSTGRES_USER=bider
POSTGRES_PASSWORD=<openssl rand -hex 16>
POSTGRES_DB=bider

# --- App ---
# Loopback only: Caddy terminates TLS and proxies to this port.
PORT_PUBLISHED=127.0.0.1:8000

# Fernet key encrypting WB cabinet tokens at rest. Generate:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# or: docker compose run --rm app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIDER_FERNET_KEY=

# Seed admin, created on first start if users table is empty.
BIDER_ADMIN_USERNAME=admin
BIDER_ADMIN_PASSWORD=<openssl rand -hex 12>

BIDER_SESSION_DAYS=30
BIDER_RAW_LOG_DAYS=14
