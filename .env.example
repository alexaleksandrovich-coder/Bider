# Bider local dev environment. Copy to .env and fill in real values.
# Never commit .env — secrets stay out of the repo.

# PostgreSQL (docker-compose.dev.yml maps host port 5436 -> container 5432)
BIDER_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5436/bider

# Fernet key used to encrypt WB cabinet tokens at rest (required).
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIDER_FERNET_KEY=

# Seed admin, created on first start if the users table is empty
BIDER_ADMIN_USERNAME=admin
BIDER_ADMIN_PASSWORD=change-me

BIDER_SESSION_DAYS=30
BIDER_RAW_LOG_DAYS=14
BIDER_RUN_COLLECTOR=false
